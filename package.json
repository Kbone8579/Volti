{
  "name": "volti",
  "version": "0.1.0",
  "description": "Volti — 손 대지 않고 넘기는 악보 (얼굴 제스처·시선으로 페이지 넘김)",
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "predev:https": "node scripts/copy-assets.mjs",
    "dev:https": "vite --host --mode https",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "lucide-react": "1.52.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261022.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.151.3"
  },
  "type": "module"
}
